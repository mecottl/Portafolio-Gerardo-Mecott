---
import Layout from "../layouts/Layout.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { experience, education, bioSummary, hackathons } from "../data/profile";
---

<Layout title="Gerardo Mecott - Web Developer" titlepage="Resumen">
  <section class="info-section">
    <h3>Experiencia</h3>
    <ul class="timeline-list">
      {experience.map((entry) => <TimelineItem entry={entry} />)}
    </ul>
  </section>

  <section class="info-section">
    <h3>Educación</h3>
    <ul class="timeline-list">
      {education.map((entry) => <TimelineItem entry={entry} />)}
    </ul>
  </section>

  <section class="info-section">
    <h3>Sobre mí</h3>
    <ul class="timeline-list">
      <li class="timeline-item">
        <div class="timeline-content">
          <strong>Resumen</strong>
          <p>{bioSummary}</p>
        </div>
      </li>
    </ul>
  </section>

  <section class="info-section">
    <h3>Concursos</h3>
    <ul class="timeline-list">
      {hackathons.map((entry) => <TimelineItem entry={entry} />)}
    </ul>
  </section>
</Layout>
