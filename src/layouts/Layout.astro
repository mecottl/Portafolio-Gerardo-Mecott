---
import "../styles/global.css";
import SkillsSection from "../components/SkillsSection.astro";

interface Props {
  title: string;
  titlepage: string;
  description?: string;
}

const {
  title,
  titlepage,
  description = "Portafolio de Gerardo Mecott, desarrollador Full-Stack: proyectos, cursos y experiencia.",
} = Astro.props;
const currentPath = Astro.url.pathname.toLowerCase().replace(/\/$/, "") || "/";

function isActive(path: string) {
  return currentPath === path.toLowerCase();
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/icon.png" />
    <title>{title}</title>
		<!-- <ClientRouter />   -->

  </head>
  <body>
    <div class="grid-container">
      <aside class="container container-profile">
        <img
          src="/pp.png"
          alt="Avatar"
          class="profile-img"
        />
        <h2 class="name">Gerardo Mecott</h2>
        <p class="job-title">Web Developer</p>
		<p class="job-title">"<b>Vibrando</b> con el <b>Código</b>"
        
        <div class="contact-section">
          <ul class="contact-list">
            <li><i class="fas fa-envelope"></i> gerardomecott@outlook.com</li>
            <li><i class="fas fa-phone"></i> +52 999 391 7172</li>
            <li><i class="fas fa-birthday-cake"></i> 12 de Junio 2004</li>
            <li><i class="fas fa-map-marker-alt"></i> Mérida, México</li>
            <li><i class="fas fa-language"></i>Ingles - B2</li>
          </ul>
        </div>

        <SkillsSection />
      </aside>

      <section class="container container-info">
        <header class="header-section">
          <h1 class="page-title">{titlepage}</h1>
          <nav class="nav-menu">
            <a href="/" class={isActive("/") ? "nav-link active" : "nav-link"}>Sobre mi</a>
            <a href="/Portafolio" class={isActive("/portafolio") ? "nav-link active" : "nav-link"}>Portafolio</a>
            <a href="/Cursos" class={isActive("/cursos") ? "nav-link active" : "nav-link"}>Cursos</a>
            <a href="/Contacto" class={isActive("/contacto") ? "nav-link active" : "nav-link"}>Contacto</a>
          </nav>
        </header>

        <div class="content-area">
          <slot />
        </div>
      </section>
    </div>
  </body>
</html>
